extends "res://tests/framework/test_case.gd"

func take_backpack() -> void:
	await interact_with(interactable("Cupboard"))
	await advance_dialogue()
	check(not GameState.has_backpack(), "opening alone does not take the backpack")
	await interact_with(interactable("Cupboard"))
	await advance_dialogue()

func test_departure_requires_both() -> void:
	await interact_with(interactable("BedroomDoor"))
	check(saw_line("I'll need my backpack and Lemon before I go."), "both missing reminder")
	check(not RoomTransition.is_busy(), "blocked without equipment")
	await advance_dialogue()
	await take_backpack()
	await interact_with(interactable("BedroomDoor"))
	check(saw_line("I'm not leaving without Lemon."), "Lemon missing reminder")
	await advance_dialogue()
	await interact_with(interactable("Lemon"))
	await advance_dialogue()
	await interact_with(interactable("BedroomDoor"))
	await wait_for_room_change()
	check_eq(room.scene_file_path,HALL_SCENE,"both allow departure")
	check(GameState.has_backpack(),"backpack persists across rooms")
	# Returning for another look must not trap Stella if Lemon waits downstairs.
	await interact_with(interactable("Lemon"))
	await advance_dialogue()
	await interact_with(interactable("Stairs"))
	await wait_for_room_change()
	await interact_with(interactable("BedroomDoor"))
	await wait_for_room_change()
	check_eq(room.scene_file_path,HALL_SCENE,"return visit cannot strand Stella away from Lemon")

func test_lemon_alone_and_repeated_trunk() -> void:
	await interact_with(interactable("Lemon"))
	await advance_dialogue()
	await interact_with(interactable("BedroomDoor"))
	check(saw_line("Nearly ready. My backpack's still in the trunk."), "backpack missing reminder")
	await advance_dialogue()
	await take_backpack()
	await interact_with(interactable("Cupboard"))
	check(saw_line("Nothing else I need in here."),"no repeated pickup")
	await advance_dialogue()

func test_inventory_ui_and_ownership() -> void:
	var ui: BackpackUI = room.get_node("BackpackUI")
	await press(&"inventory")
	check(not ui.is_open, "inventory unavailable before backpack")
	await take_backpack()
	var item := InventoryItem.new()
	item.id = &"test_compass"
	item.display_name = "Compass"
	item.description = "A test compass."
	check(GameState.add_item(&"stella",item),"add owned item")
	check(not GameState.add_item(&"stella",item),"reject duplicate")
	check(not GameState.has_item(&"max",item.id),"Max has separate inventory")
	await click_screen(ui.button.position+Vector2(30,20))
	check(ui.is_open,"button opens inventory")
	var position_before := stella.position
	await click_world(Vector2(1000,660))
	await wait_physics_frames(10)
	check_eq(stella.position,position_before,"inventory blocks world movement")
	await press(&"ui_cancel")
	check(not ui.is_open and PlayerControl.has_control(),"Escape releases control")
	await press(&"inventory")
	check(ui.is_open,"I opens inventory")
	await press(&"inventory")
	check(not ui.is_open,"I closes inventory")
	check(GameState.remove_item(&"stella",item.id),"remove item")
	GameState.reset()
	check(not ui.button.visible,"reset hides backpack")
	check(GameState.inventory_items(&"stella").is_empty(),"reset clears inventory")

func test_wardrobe_discovery_and_cleanup() -> void:
	await interact_with(interactable("Wardrobe"))
	var views := room.find_children("*", "WardrobeView", true, false)
	check_eq(views.size(),1,"wardrobe opens close-up")
	check(GameState.has_flag(GameState.FLAG_MOUSE_DISCOVERED),"discovery recorded")
	check(not PlayerControl.has_control(),"wardrobe blocks movement")
	await wait_seconds(2.0)
	check(views[0].illustration.mouse_out,"mouse emerges")
	await press(&"ui_cancel")
	await wait_frames(2)
	check(PlayerControl.has_control(),"wardrobe releases control")
	check(not AudioManager._music_overrides.has(&"wardrobe"),"music override removed")
	await interact_with(interactable("Wardrobe"))
	await press(&"ui_cancel")
	await wait_frames(2)
	check(PlayerControl.has_control(),"wardrobe can reopen")
