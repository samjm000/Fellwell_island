[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/telescope_view.gd" id="1_view"]

[sub_resource type="Shader" id="Shader_eyepiece"]
code = "shader_type canvas_item;

// Black everywhere except a soft-edged circle: the telescope eyepiece.
uniform float radius = 0.45;
uniform float softness = 0.03;
uniform float aspect = 1.7778;

void fragment() {
	vec2 offset = UV - vec2(0.5);
	offset.x *= aspect;
	float edge = smoothstep(radius - softness, radius, length(offset));
	COLOR = vec4(0.0, 0.0, 0.0, edge);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_eyepiece"]
shader = SubResource("Shader_eyepiece")
shader_parameter/radius = 0.45
shader_parameter/softness = 0.03
shader_parameter/aspect = 1.7778

