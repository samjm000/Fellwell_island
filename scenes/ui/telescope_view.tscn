[sub_resource type="Shader" id="Shader_eyepiece"]
code = "shader_type canvas_item;

// The telescope eyepiece: black outside a soft-edged circle, a shadowed rim just
// inside it and a faint brass glint on the edge. One pass, no textures.
uniform vec2 center = vec2(0.5, 0.5);
uniform float radius = 0.45;
uniform float softness = 0.02;
uniform float rim_width = 0.09;
uniform float aspect = 1.7778;
uniform vec4 brass : source_color = vec4(0.72, 0.55, 0.28, 1.0);

void fragment() {
	vec2 offset = UV - center;
	offset.x *= aspect;
	float d = length(offset);
	float outside = smoothstep(radius - softness, radius, d);
	float rim_shadow = smoothstep(radius - rim_width, radius, d) * 0.6;
	float ring = smoothstep(radius - 0.012, radius - 0.004, d) * (1.0 - smoothstep(radius - 0.004, radius + 0.004, d));
	// Light catches the upper-left of the ring.
	float glint = ring * (0.25 + 0.35 * clamp(dot(normalize(offset + 1e-5), vec2(-0.6, -0.8)), 0.0, 1.0));
	vec3 colour = mix(vec3(0.01, 0.01, 0.02), brass.rgb, glint);
	COLOR = vec4(colour, max(max(outside, rim_shadow), glint));
}
"

