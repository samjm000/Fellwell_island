[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/interaction_prompt.gd" id="1_interaction_prompt"]

[node name="InteractionPrompt" type="PanelContainer"]
mouse_filter = 2
theme_type_variation = &"PromptBubble"
script = ExtResource("1_interaction_prompt")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="KeyCap" type="PanelContainer" parent="Row"]
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"KeyCap"

[node name="KeyLabel" type="Label" parent="Row/KeyCap"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"KeyCapLabel"
text = ""
horizontal_alignment = 1

[node name="Label" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PromptLabel"
text = "Look at Thing"
